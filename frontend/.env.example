# ESSCAN frontend configuration.

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
# Change these three lines to rename the application. They feed the page
# title, the login and signup screens, both topbars and the PWA manifest.
# The logo is a file: replace src/assets/mainLogo.png, then regenerate the
# icons in public/ (see README_V7_9_9.md).
#
# Restart Vite after editing -- index.html and the manifest are generated at
# startup, so a hot reload will not pick these up.
VITE_APP_NAME=ESSCAN
VITE_APP_SHORT_NAME=ESSCAN
VITE_APP_THEME_COLOR=#462776

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# The browser talks to the Vite dev server, which proxies /api to FastAPI.
# Keeping this relative means no CORS preflight and no mixed content when the
# page is served over HTTPS.
VITE_API_BASE_URL=/api

# Where FastAPI is listening, as seen from the machine running Vite.
# Change this and nothing else when the backend moves.
#   same machine:  http://127.0.0.1:8000
#   another host:  http://192.168.93.19:8000
VITE_BACKEND_TARGET=http://127.0.0.1:8000
