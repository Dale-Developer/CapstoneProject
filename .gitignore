# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Environment secrets — never commit real credentials
backend/.env

# Backups — generated locally, do not version
backend/backups/

# Node
frontend/node_modules/
frontend/dist/

# Uploaded student data — do not version real scans/PII
backend/uploads/student_submissions/*
!backend/uploads/student_submissions/.gitkeep

# AI model weights — large binaries, distribute separately
backend/ai_models/*/model/*.pth
backend/ai_models/*/model/*.safetensors

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/


# Local env copies and notes that may contain secrets
env_final.txt
*.env.local

# OCR debug output (contains real scanned answer sheets)
backend/ocr_debug/

# Vite dev-mode service worker output
frontend/dev-dist/

# Database dumps (contain user accounts and student data)
*.sql.zip
automate_assessment_application*.sql