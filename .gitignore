# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Environment secrets — never commit real credentials
backend/.env

# Node
frontend/node_modules/
frontend/dist/

# Uploaded student data — do not version real scans/PII
backend/uploads/student_submissions/*
