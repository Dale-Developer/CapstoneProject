# ESSCAN V7.8.1 local development
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=automate_assessment_application

JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

EASYOCR_MODEL_DIR=./ai_models/easyocr_v5_2/model
EASYOCR_USER_NETWORK_DIR=./ai_models/easyocr_v5_2/user_network
EASYOCR_RECOG_NETWORK=handwriting_finetune_v5_2
EASYOCR_GPU=0
EASYOCR_DOWNLOAD_ENABLED=1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_OCR_VERIFY=true
OLLAMA_OCR_MIN_CONFIDENCE=0.62
OLLAMA_AGREEMENT_THRESHOLD=0.70
OLLAMA_OCR_TIMEOUT_SECONDS=35

OMR_FILL_THRESHOLD=0.24
OMR_AMBIGUITY_MARGIN=0.055

SCANNER_MASTER_SCALE=3
SCANNER_MASTER_JPEG_QUALITY=94
SCANNER_CLAHE_CLIP=1.5

OCR_TARGET_WIDTH=1800
OCR_MAX_WIDTH=2400
OCR_SECOND_PASS_CONFIDENCE=0.62
OCR_REGION_RECHECK_LIMIT=6
OCR_RECHECK_CONFIDENCE=0.55

# ============================================================
# ESSCAN V7.9 - NLP (spaCy) and essay grading
# ============================================================

SPACY_MODEL=en_core_web_sm
# parser/ner are not needed for grading and roughly double processing time.
SPACY_DISABLE=parser,ner
NLP_FUZZY_MATCH_THRESHOLD=0.86


# ---- Grading behaviour ----
# Essay criterion WEIGHTS are NOT configured here. They come from the rubric
# the professor set for each question (exam_rubrics). The settings below only
# tune how individual criteria are measured.

# Share of Writing Quality attributable to spelling. Kept low because these
# are OCR transcriptions of handwriting: an unknown word is as likely to be a
# recognition error as a student mistake.
ESSAY_SPELLING_SHARE=0.25
# How similar an unknown word must be to a professor-supplied term before it
# is treated as OCR damage rather than a misspelling.
NLP_OCR_LENIENCY_THRESHOLD=0.78
# Share of Key Ideas contributed by keyword evidence. Keywords support Key
# Ideas; they are not a standalone rubric criterion.
ESSAY_KEYWORD_SUPPORT_SHARE=0.20
# Fraction of a requirement's content words that must appear for it to count.
ESSAY_REQUIREMENT_THRESHOLD=0.5

# ---- Sentence-BERT (Answer Relevance) ----
# Production model: ESSCAN_AAA_SBERT_ASAP_V3 (score-aware ASAP fine-tune),
# selected on project evaluation - it beats STSB V1, ASAP V2 and the stock
# baseline on every metric:
#   MAE 0.4344 | RMSE 0.5758 | Pearson 0.7459 | Spearman 0.7404
#
# SBERT_MODEL_PATH may point at the release folder or its inner model/ dir.
# If the model cannot be loaded the engine falls back to a lexical measure
# and reports that it did.
SBERT_ENABLED=true
SBERT_MODEL_PATH=./ai_models/ESSCAN_AAA_SBERT_ASAP_V3_FINAL
SBERT_DEVICE=cpu

# Calibration. V3 was trained with CosineSimilarityLoss, so its raw cosine on
# exam answers sits in a narrow, high band: ~0.70 for completely unrelated
# text up to ~0.99 for a fully correct answer. Without rescaling, an answer
# about basketball would score ~70% on Answer Relevance. These bounds map the
# operating band onto 0..1. Retune them if you deploy a different checkpoint;
# setting floor >= ceiling disables rescaling.
SBERT_SIMILARITY_FLOOR=0.80
SBERT_SIMILARITY_CEILING=0.97

# ============================================================
# ESSCAN V7.9 - Performance
# ============================================================

# How many answer-sheet pages are processed concurrently.
ESSCAN_PAGE_WORKERS=3
# Leave one core free so OpenCV and FastAPI are not starved by torch.
ESSCAN_TORCH_THREADS=3
ESSCAN_OPENCV_THREADS=2

# Load models at startup instead of inside the first upload request.
ESSCAN_WARMUP_EASYOCR=true
ESSCAN_WARMUP_SPACY=true
ESSCAN_WARMUP_OLLAMA=true

# Keep the vision model resident so pages after the first do not reload it.
OLLAMA_KEEP_ALIVE=15m
# Cache the "is Ollama up?" probe instead of an HTTP call per page.
OLLAMA_PROBE_TTL_SECONDS=20
# Send Ollama a downscaled JPEG rather than a full-resolution PNG.
OLLAMA_IMAGE_MAX_EDGE=1400
OLLAMA_IMAGE_JPEG=true
OLLAMA_IMAGE_JPEG_QUALITY=88
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=4096

# ---- Speed: scanning & identification (V7.9.5) ----
# Corner/registration-mark detection used to run at the phone's full camera
# resolution even though only 4 corner coordinates are ever kept — the
# detection preview itself was thrown away and redone at full resolution
# anyway. Detection now runs on a capped copy and scales the winning corners
# back up before the real, full-quality warp, so this does not affect final
# OCR/OMR image quality. Lower it only after confirming detection still
# succeeds on your actual answer sheets (registration marks below ~50px in
# whatever resolution they're evaluated at get rejected); set to 0 to fully
# disable and restore the original full-resolution behavior.
SCANNER_DETECTION_MAX_DIM=1800

# Identification-specific Ollama output cap. "NAME: X / NO: Y / SEC: Z" needs
# far fewer tokens than an essay transcription, and capping generation length
# is one of the most reliable ways to cut local-model latency (it directly
# bounds decode steps). This does not affect OLLAMA_NUM_PREDICT, which still
# governs essay-answer transcription.
OLLAMA_ID_NUM_PREDICT=80

# Sentence-BERT encode() batch size when grading multiple essay questions in
# one submission together (see nlp_spacy.batch_semantic_similarity). Raise
# this on a GPU with headroom; the CPU default is conservative.
SBERT_BATCH_SIZE=32

# ---- Security & limits (V7.9.6) ----
# Comma-separated list of frontend origins allowed to call this API. Change
# this per environment (dev/staging/prod) instead of editing main.py.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.20:5173

# Maximum size, in MB, for a single uploaded answer-sheet page.
MAX_UPLOAD_MB=15
